  "voice": {
    "engine": "gemini",
    "model": "gemini-2.5-flash-preview-tts",
    "name": "Puck",
    "style": "You are an upbeat, confident tech explainer talking straight to one student who just asked what this new 'dot' thing in ChatGPT is. A warm, curious tech friend who just read the manual: brisk and pleased on the demo, calm and honest on the catch. Calm pace, about 2.3 words per second, never rushed; a real pause at every full stop and a short breath at every comma. Open hushed and close-up on 'It's three A.M.', then brighter on 'By morning'. Say 'three A.M.' as the letters A, M. Say 'ChatGPT' as chat-G-P-T, 'iOS' as eye-O-S, 'dot' as a plain word. Slow down on 'Now, the part that matters' and read the four levels one by one with a beat between them. Take one breath before 'Now, here's the catch' and say the catch calmly, never alarmed. Warm and practical on 'My take?'. Smile on the last line. Read every word exactly as written. Never hyped, never robotic.",
    "minPause": {
      "sentence": 0.75,
      "comma": 0.3
    }
  },
  "stage": {
    "kit": "reference-flat",
    "html": "stage/stage.html",
    "css": "stage/stage.css",
    "js": "stage/stage.js"
  },
