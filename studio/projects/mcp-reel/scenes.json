          "check": "reveal",
          "sfx": "stamp"
        },
        {
          "target": "check",
          "word": "check",
          "check": "reveal",
          "sfx": "none"
        },
        {
          "target": "weather",
          "word": "weather",
          "offset": -0.1,
          "sfx": "none",
          "check": "reveal"
